# =============================================================
# SecureVault — Production environment variables
# Copy to .env and fill in your values before running:
#   docker compose -f docker-compose.yaml -f docker-compose.prod.yaml up -d
# =============================================================

# --- Required: Traefik / TLS ---
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=<generate-a-strong-random-string>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<same-as-above>

# --- JWT ---
JWT_SECRET=<generate-a-256-bit-hex-key>

# --- Encryption (AES-256-GCM key for 2FA secrets at rest) ---
ENCRYPTION_KEY=<generate-a-32-byte-base64-key>

# --- Server hash secret (PBKDF2 server-side salt) ---
SERVER_HASH_SECRET=<generate-a-256-bit-hex-key>

# --- Redis ---
REDIS_PASSWORD=<generate-a-strong-random-string>

# --- Optional: override defaults ---
# JWT_EXPIRATION=3600000
# JWT_REFRESH_EXPIRATION=2592000000
# RATE_LIMIT=60
# LOG_LEVEL=INFO
