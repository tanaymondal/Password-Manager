{
  "manifest_version": 3,
  "name": "SecureVault",
  "version": "1.0.0",
  "description": "Zero-knowledge password manager",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval';"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://vault.tanay.pro/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "SecureVault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
