# SecureVault Environment Variables
# Copy this to .env and fill in values before deployment
#
# These are loaded by docker-compose.yaml automatically.
# Set these in your Dokploy environment config instead of .env for production.

# ===================
# REQUIRED SECRETS
# ===================

# Database
DB_USERNAME=postgres
DB_PASSWORD=change_me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# JWT Secret — generate with: openssl rand -base64 48
JWT_SECRET=

# Encryption key for 2FA secrets at rest — generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Redis
REDIS_PASSWORD=change_me
