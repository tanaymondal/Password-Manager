# SecureVault Environment Variables
# Copy this to .env and fill in values before deployment
#
# These are loaded by docker-compose.yaml automatically.
# Set these in your Dokploy environment config instead of .env for production.

# ===================
# REQUIRED SECRETS
# ===================

# Database
DB_USERNAME=postgres
DB_PASSWORD=change_me_to_a_random_value
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_random_value

# JWT Secret — generate with: openssl rand -hex 64
JWT_SECRET=

# Encryption key for 2FA secrets at rest — generate with: openssl rand -base64 32 | tr '+/' 'AB' | tr -d '='
ENCRYPTION_KEY=

# Server hash secret (PBKDF2 server-side pepper) — generate with: openssl rand -hex 32
SERVER_HASH_SECRET=

# Redis
REDIS_PASSWORD=change_me_to_a_random_value
