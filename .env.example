# SecureVault Environment Variables
# Copy this to .env and fill in values before deployment

# ===================
# REQUIRED VARIABLES
# ===================

# Database - PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securevault
DB_USERNAME=securevault_user
DB_PASSWORD=your_secure_password_here

# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_random_256_bit_secret_key_min_32_chars

# ====================
# OPTIONAL VARIABLES
# ====================

# Server
SERVER_PORT=8080

# Security
REQUIRE_SSL=true
SWAGGER_ENABLED=false
RATE_LIMIT=30

# Redis (optional - for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT expiration (optional)
# JWT_EXPIRATION=3600000
# JWT_REFRESH_EXPIRATION=86400000

# Logging
# LOG_LEVEL=INFO